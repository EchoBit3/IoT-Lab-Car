<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Global default: forbid cleartext traffic (HTTPS/TLS required by default per OWASP MASVS & ISO/IEC 27002) -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Scoped exception strictly for local ESP32 SoftAP and LAN gateway IPv4 addresses without Internet -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
    </domain-config>
</network-security-config>
